# Doxygen configuration of the portfolio project.
# Build the reference with:  doxygen Doxyfile
# Keys that are not listed keep the Doxygen default.

PROJECT_NAME           = "Portfolio Website"
PROJECT_BRIEF          = "A portfolio website generator built with the Python standard library"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Python source in src/, documented with Doxygen commands in docstrings and ## comments
INPUT                  = src README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
